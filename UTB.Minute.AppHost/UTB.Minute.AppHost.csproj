    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>6a4be12e-9772-4c31-8883-3bd170f7bdd0</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Realm\utb-minute-realm.json" />
