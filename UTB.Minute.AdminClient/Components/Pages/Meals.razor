@page "/meals"
@using UTB.Minute.Contracts.Meals
@using Microsoft.AspNetCore.Components.Authorization
@using UTB.Minute.AdminClient
@inject AdminService AdminService
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<AuthorizeView Roles="canteen-admin">
    <Authorized>
        <h3>Meals</h3>

        <p>Welcome back @context.User.Identity?.Name!</p>

        <form action="/logout" method="post" style="display:inline">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-link p-0">Logout</button>
        </form>

        <hr />

        <h5>Create meal</h5>

        <div class="mb-2">
            <input class="form-control" placeholder="Name" @bind="newMealName" />
        </div>

        <div class="mb-2">
            <input class="form-control" placeholder="Description" @bind="newMealDescription" />
        </div>

        <button class="btn btn-primary mb-3" @onclick="CreateMeal">Create</button>

        @if (meals is null)
        {
            <p><em>Loading...</em></p>
        }
        else if (!meals.Any())
        {
            <p>No meals.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var meal in meals)
                    {
                        <tr>
                            <td>@meal.Id</td>
                            <td>
                                <input class="form-control" @bind="editNames[meal.Id]" />
                            </td>
                            <td>
                                <input class="form-control" @bind="editDescriptions[meal.Id]" />
                            </td>
                            <td>@meal.IsActive</td>
                            <td>
                                <button class="btn btn-sm btn-success me-1"
                                        @onclick="() => UpdateMeal(meal)">
                                    Save
                                </button>

                                @if (meal.IsActive)
                                {
                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => DeactivateMeal(meal.Id)">
                                        Deactivate
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Authorized>

    <NotAuthorized>
        <p><a href="/login?returnUrl=/meals" data-enhance-nav="false">Log in</a> please.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MealDto[]? meals;
    private bool loaded;

    private string newMealName = string.Empty;
    private string newMealDescription = string.Empty;

    private readonly Dictionary<int, string> editNames = new();
    private readonly Dictionary<int, string> editDescriptions = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true || !user.IsInRole("admin"))
        {
            return;
        }

        loaded = true;
        await LoadMeals();
        StateHasChanged();
    }

    private async Task LoadMeals()
    {
        meals = await AdminService.GetMealsAsync();

        editNames.Clear();
        editDescriptions.Clear();

        if (meals is null)
        {
            return;
        }

        foreach (var meal in meals)
        {
            editNames[meal.Id] = meal.Name;
            editDescriptions[meal.Id] = meal.Description;
        }
    }

    private async Task CreateMeal()
    {
        if (string.IsNullOrWhiteSpace(newMealName))
        {
            return;
        }

        await AdminService.CreateMealAsync(
            new CreateMealDto(newMealName, newMealDescription));

        newMealName = string.Empty;
        newMealDescription = string.Empty;

        await LoadMeals();
    }

    private async Task UpdateMeal(MealDto meal)
    {
        await AdminService.UpdateMealAsync(
            meal.Id,
            new UpdateMealDto(
                editNames[meal.Id],
                editDescriptions[meal.Id],
                meal.IsActive));

        await LoadMeals();
    }

    private async Task DeactivateMeal(int id)
    {
        await AdminService.DeactivateMealAsync(id);
        await LoadMeals();
    }
}