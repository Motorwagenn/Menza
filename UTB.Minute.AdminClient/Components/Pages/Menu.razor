@page "/menu"
@using UTB.Minute.Contracts.Meals
@using UTB.Minute.Contracts.Menu
@using Microsoft.AspNetCore.Components.Authorization
@using UTB.Minute.AdminClient
@inject AdminService AdminService
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<AuthorizeView Roles="cook">
    <Authorized>

        <div class="alert alert-warning">
            Nedostatečná role.
        </div>

        <form action="/logout" method="post" style="display:inline">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-link p-0">
                Logout
            </button>
        </form>
    </Authorized>
    
</AuthorizeView>

<AuthorizeView Roles="canteen-admin">
    <Authorized>
        <h3>Menu</h3>

        <p>Welcome back @context.User.Identity?.Name!</p>

        <form action="/logout" method="post" style="display:inline">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-link p-0">Logout</button>
        </form>

        <hr />

        <h5>Create menu item</h5>

        <div class="mb-2">
            <label>Date</label>
            <input class="form-control" type="date" @bind="newMenuDate" />
        </div>

        <div class="mb-2">
            <label>Meal</label>
            <select class="form-control" @bind="newMealId">
                <option value="0">-- select meal --</option>
                @if (meals is not null)
                {
                    @foreach (var meal in meals.Where(m => m.IsActive))
                    {
                        <option value="@meal.Id">@meal.Name</option>
                    }
                }
            </select>
        </div>

        <div class="mb-2">
            <label>Available portions</label>
            <input class="form-control" type="number" @bind="newAvailablePortions" />
        </div>

        <button class="btn btn-primary mb-3" @onclick="CreateMenuItem">Create</button>

        @if (menuItems is null)
        {
            <p><em>Loading...</em></p>
        }
        else if (!menuItems.Any())
        {
            <p>No menu items.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Date</th>
                        <th>Meal</th>
                        <th>Portions</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in menuItems)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <input class="form-control" type="date" @bind="editDates[item.Id]" />
                            </td>
                            <td>
                                <select class="form-control" @bind="editMealIds[item.Id]">
                                    @if (meals is not null)
                                    {
                                        @foreach (var meal in meals.Where(m => m.IsActive))
                                        {
                                            <option value="@meal.Id">@meal.Name</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                <input class="form-control" type="number" @bind="editPortions[item.Id]" />
                            </td>
                            <td>
                                <button class="btn btn-sm btn-success me-1"
                                        @onclick="() => UpdateMenuItem(item.Id)">
                                    Save
                                </button>

                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => DeleteMenuItem(item.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Authorized>

    
</AuthorizeView>

<AuthorizeView>
    <NotAuthorized>
        <p><a href="/login?returnUrl=/menu" data-enhance-nav="false">Log in</a> please.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MealDto[]? meals;
    private MenuItemDto[]? menuItems;
    private bool loaded;

    private DateOnly newMenuDate = DateOnly.FromDateTime(DateTime.Today);
    private int newMealId;
    private int newAvailablePortions = 10;

    private readonly Dictionary<int, DateOnly> editDates = new();
    private readonly Dictionary<int, int> editMealIds = new();
    private readonly Dictionary<int, int> editPortions = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true || !user.IsInRole("admin"))
        {
            return;
        }

        loaded = true;
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        meals = await AdminService.GetMealsAsync();
        menuItems = await AdminService.GetMenuItemsAsync();

        editDates.Clear();
        editMealIds.Clear();
        editPortions.Clear();

        if (menuItems is null)
        {
            return;
        }

        foreach (var item in menuItems)
        {
            editDates[item.Id] = item.Date;
            editMealIds[item.Id] = item.MealId;
            editPortions[item.Id] = item.AvailablePortions;
        }
    }

    private async Task CreateMenuItem()
    {
        if (newMealId <= 0)
        {
            return;
        }

        await AdminService.CreateMenuItemAsync(
            new CreateMenuItemDto(
                newMenuDate,
                newMealId,
                newAvailablePortions));

        await LoadData();
    }

    private async Task UpdateMenuItem(int id)
    {
        await AdminService.UpdateMenuItemAsync(
            id,
            new UpdateMenuItemDto(
                editDates[id],
                editMealIds[id],
                editPortions[id]));

        await LoadData();
    }

    private async Task DeleteMenuItem(int id)
    {
        await AdminService.DeleteMenuItemAsync(id);
        await LoadData();
    }
}