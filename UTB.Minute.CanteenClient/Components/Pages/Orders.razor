@page "/orders"
@using UTB.Minute.Contracts.Orders
@using UTB.Minute.Contracts.Enums
@using UTB.Minute.CanteenClient
@using Microsoft.AspNetCore.Components.Authorization
@inject CanteenService CanteenService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<AuthorizeView Roles="cook">
<Authorized>
<h3>Orders</h3>
        

@if (orders is null)
{
    <p><em>Loading...</em></p>
}
else if (!orders.Any())
{
            <p>Welcome back @context.User.Identity?.Name!</p>
            <form action="/logout" method="post" style="display:inline">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link p-0">
                    Logout
                </button>
            </form>

    <p>No active orders.</p>
}
else
{
            <p>Welcome back @context.User.Identity?.Name!</p>
            <form action="/logout" method="post" style="display:inline">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link p-0">
                    Logout
                </button>
            </form>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Meal</th>
                <th>Status</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.MealName</td>
                    <td>@order.Status</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        @if (order.Status == OrderStatus.Preparing)
                        {
                            <button class="btn btn-sm btn-success me-1" @onclick="() => SetStatus(order.Id, OrderStatus.Ready)">Ready</button>
                            <button class="btn btn-sm btn-danger me-1" @onclick="() => SetStatus(order.Id, OrderStatus.Cancelled)">Cancel</button>
                        }
                        @if (order.Status == OrderStatus.Ready || order.Status == OrderStatus.Cancelled)
                        {
                            <button class="btn btn-sm btn-secondary" @onclick="() => SetStatus(order.Id, OrderStatus.Completed)">Complete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
</Authorized>
    <NotAuthorized>
        <p><a href="/login?returnUrl=/orders" data-enhance-nav="false" >Log in</a> please.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private OrderDto[]? orders;
    private bool loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded)
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        if (!user.IsInRole("cook"))
        {
            return;
        }

        loaded = true;
        await LoadOrders();
        StateHasChanged();
    }

    private async Task LoadOrders()
    {
        orders = await CanteenService.GetOrdersAsync();
    }

    private async Task SetStatus(int id, OrderStatus status)
    {
        await CanteenService.UpdateOrderStatusAsync(id, new UpdateOrderStatusDto(status));
        await LoadOrders();
    }
}